# Copie este arquivo para ".env" e preencha com os seus valores.
# O arquivo ".env" NUNCA deve ser enviado para o GitHub (ele já está no .gitignore).

# Connection string do MongoDB Atlas (veja o passo a passo para pegar a sua)
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/favor?retryWrites=true&w=majority

# Uma frase secreta, longa e única, usada para assinar os logins (tokens JWT).
# Invente a sua - não use a mesma de exemplos que você encontrar na internet.
JWT_SECRET=troque-isso-por-uma-frase-longa-e-unica-so-sua

# Porta do servidor (o Render define isso sozinho, pode deixar como está)
PORT=3000
